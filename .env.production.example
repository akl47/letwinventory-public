JWT_SECRET=
BACKEND_PORT=3000
PGADMIN_PORT=5050
FRONTEND_URL=https://letwinventory.letwin.co

DB_PORT=5432
DB_HOST=host.docker.internal
DB_NAME=letwinventory
DB_SCHEMA=public
DB_USERNAME=letwinventory_user
DB_PASSWORD=
DB_DIALECT=postgres
DB_LOGGING=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://letwinventory.letwin.co/api/auth/google/callback

# Print Agent (for local network printing from hosted server)
# Generate with: openssl rand -hex 32
PRINT_AGENT_API_KEY=

# DigiKey API
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Backup Email (Gmail SMTP) — used by scripts/backup-db.sh, scripts/deploy-update.sh
SMTP_EMAIL=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
