# Credentials for Claude Code's helper scripts (req.js, feature.js, tool scripts).
# Copy to .env.claude and fill in. .env.claude is gitignored.

# API key exchanged at /auth/api-key/token for a 1h JWT (cached in /tmp).
# Issue one in the app under Settings -> API Keys for a user with the perms
# the scripts need (requirements.{read,write,approve}, features.{read,write,approve}).

# Use exactly one of these two. DEV_TEMP_API_KEY wins if both are set.
DEV_TEMP_API_KEY=
PROD_API_KEY=

# Base URL override. Defaults to https://letwinventory.letwin.co/api.
# For local dev: http://localhost:3000/api
# PROD_API_URL=

# Separate key used only by the tool/drill scripts (set-drill-diameters.js,
# fill-drill-bit-dimensions.js, annotate-tap-drills.js, assign-tool-subcategories.js).
# Falls back to PROD_API_KEY if unset.
# TOOL_PROD_API_KEY=
